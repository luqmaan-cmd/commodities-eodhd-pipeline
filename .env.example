# EODHD Commodities Pipeline — Environment Variables
# Copy this to .env and fill in your actual values.
# NEVER commit the .env file.

EODHD_API_KEY=your_eodhd_api_key_here
DB_URL=postgresql://user:password@host:5432/dbname
SLACK_WEBHOOK_URL=

# GCP — path to service account key JSON (mounted as a volume in Cloud Run)
# For local dev: path to your key file on disk
# For Cloud Run: set GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-key.json
GOOGLE_APPLICATION_CREDENTIALS=
